FROM python:3.12-slim
WORKDIR /code
ENV PYTHONUNBUFFERED=1
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir '.[ui]'
COPY ui ./ui
RUN useradd --uid 10001 --create-home app
USER app
EXPOSE 8501
CMD ["streamlit", "run", "ui/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
